# Database — use Supabase (free 500MB) or Neon (free 3GB)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require

# Auth
JWT_SECRET=replace-this-with-64-char-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-this-with-64-char-random-string-different
REFRESH_TOKEN_EXPIRES_IN=7d

# App URLs — comma separated, include Vercel URL
APP_URL=https://studentvault-web.vercel.app,http://localhost:3000
API_URL=https://studentvault-api.onrender.com
NODE_ENV=production
PORT=10000

# Storage — choose ONE:
# Option A: Cloudflare R2 (S3 compatible, 10GB free) — RECOMMENDED for free
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your-r2-access-key
STORAGE_SECRET_KEY=your-r2-secret-key
STORAGE_BUCKET=studentvault
STORAGE_USE_SSL=true

# Option B: Supabase Storage (already have DB)
# STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
# Same keys as Supabase S3

# Option C: Local FS fallback (ephemeral on Render/Koyeb, only for demo)
# Leave STORAGE_ENDPOINT empty to use tmpdir
