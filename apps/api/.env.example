# Database
DATABASE_URL=postgresql://studentvault_user:studentvault_pass@localhost:5432/studentvault

# Authentication
JWT_SECRET=your-jwt-secret-key-here-make-it-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-here-make-it-at-least-64-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Application
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development

# Object Storage (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=studentvault
STORAGE_USE_SSL=false

# Server
PORT=3001